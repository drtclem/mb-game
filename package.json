{
  "name": "mb-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "rooms": "node server/rooms.mjs",
    "start": "node server/rooms.mjs",
    "test:rooms": "node --test tests/rooms.acceptance.mjs",
    "build": "tsc && vite build",
    "test": "vitest run",
    "check": "tsc --noEmit --noUnusedLocals --noUnusedParameters"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.180.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.12"
  }
}
